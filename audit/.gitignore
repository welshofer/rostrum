# Keep the audit record and lightweight evidence; generated scratch stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/PERFORMANCE.md
!/REPORT.md
!/inventory.md
!/prompt-audit.md
!/session-notes.md
!/style-review.md
!/verification.md
!/diffs/
!/preview-identity.png
!/preview-layout-720.png
!/preview-layout-1000.png
!/preview-timings.json
!/aspect-fixtures.swift
!/benchmark-fixtures.swift
!/make-test-images.py
!/final-remaining-checks.sh
!/implementation-logs/
/implementation-logs/*
!/implementation-logs/final-app-summary.json
!/implementation-logs/R8-app-summary.json
!/benchmarks/
/benchmarks/*
!/benchmarks/*-release.json
!/benchmarks/*-release-resources.txt
